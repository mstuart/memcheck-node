{
	"name": "memcheck-node",
	"version": "1.0.0",
	"description": "Automated memory leak regression testing for Node.js — detect growing object graphs in CI",
	"license": "MIT",
	"repository": "mstuart/memcheck-node",
	"author": {
		"name": "Mark Stuart",
		"email": "mstuart@users.noreply.github.com",
		"url": "https://github.com/mstuart"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		}
	},
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"test": "ava && tsd",
		"check": "ultracite check",
		"fix": "ultracite fix"
	},
	"keywords": [
		"memory",
		"leak",
		"detect",
		"test",
		"ci",
		"heap",
		"snapshot",
		"regression",
		"v8",
		"gc"
	],
	"dependencies": {
		"mem-pressure": "^1.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"ava": "^8",
		"tsd": "^0.33",
		"ultracite": "7.10.2"
	}
}
