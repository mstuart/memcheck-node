{
	"name": "memcheck-node",
	"version": "1.0.0",
	"description": "Automated memory leak regression testing for Node.js — detect growing object graphs in CI",
	"license": "MIT",
	"repository": "mstuart/memcheck-node",
	"author": {
		"name": "Mark Stuart",
		"email": "mstuart@users.noreply.github.com",
		"url": "https://github.com/mstuart"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		}
	},
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"test": "xo && ava && tsd"
	},
	"keywords": [
		"memory",
		"leak",
		"detect",
		"test",
		"ci",
		"heap",
		"snapshot",
		"regression",
		"v8",
		"gc"
	],
	"dependencies": {
		"mem-pressure": "^1.0.0"
	},
	"devDependencies": {
		"ava": "^8",
		"tsd": "^0.33",
		"xo": "^2.0"
	},
	"xo": {
		"rules": {
			"@stylistic/curly-newline": [
				"error",
				{
					"multiline": true,
					"consistent": true
				}
			]
		}
	}
}
